# Required
   DATABASE_URL=postgresql://postgres:change-me@localhost:5432/middleware
   MW_MASTER_KEY=replace-with-32-bytes-base64
   MW_MASTER_KEY_VERSION=1
   BETTER_AUTH_SECRET=replace-with-a-long-random-string
   BETTER_AUTH_URL=http://localhost:3000
   APP_URL=https://app.example.com
   API_INTERNAL_URL=http://localhost:3001

   # Optional integrations
   GOOGLE_CLIENT_ID=replace-with-google-client-id
   GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
   GOOGLE_INTEGRATION_CLIENT_ID=replace-with-google-integration-client-id
   GOOGLE_INTEGRATION_CLIENT_SECRET=replace-with-google-integration-client-secret
   MAIL_FROM=Middleware <no-reply@example.com>
   SMTP_URL=smtp://change-me:change-me@localhost:1025
   WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
   WHATSAPP_ACCESS_TOKEN=replace-with-access-token
   WHATSAPP_APP_SECRET=replace-with-app-secret
   WHATSAPP_VERIFY_TOKEN=replace-with-verify-token
   WHATSAPP_TEMPLATE_RESUMEN=replace-with-template-name
   MW_SANDBOX_VM=0
   LOG_LEVEL=info