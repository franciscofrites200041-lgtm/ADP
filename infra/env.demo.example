# Template for the `env` file of one VPS environment (WP-08).
#
# Copy to /opt/middleware/demo/env, fill the secrets, and never commit the result.
# Every value here is read by an existing Zod schema: a typo fails at startup
# with a clear message instead of at the first request.
#
# NOT in this file, by design: provider API keys. §8/S3 blocks the app from
# starting if any provider key is in the environment; keys are per workspace,
# encrypted in the database and passed explicitly per execution.

# --- Public identity of this environment (Q1: the domain is not decided yet) ---
APP_DOMAIN=demo.example.com

# --- Database: matches the postgres service of compose.prod.yaml ---
POSTGRES_USER=middleware
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=middleware
DATABASE_URL=postgres://middleware:replace-me@postgres:5432/middleware

# --- Better Auth: the secret must be 32 characters or more ---
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://demo.example.com

# --- Mail: verification, recovery and, later, deliveries (Q3: Resend pending) ---
SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM=Middleware <no-reply@example.com>

# --- Envelope encryption master key (§8/S1). Generate with: openssl rand -base64 32 ---
MW_MASTER_KEY=replace-with-a-base64-32-byte-key
MW_MASTER_KEY_VERSION=1

# --- Lifecycle ---
MW_SHUTDOWN_GRACE_SECONDS=60
